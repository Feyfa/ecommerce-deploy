# Accept forwarded client addresses only from the configured Cloudflare Tunnel connector.
set_real_ip_from ${TRUSTED_EDGE_PROXY};
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

server {
    listen 8080 default_server;
    server_name tokshop.click production-vm localhost;

    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 8081 default_server;
    server_name api.tokshop.click production-vm localhost;

    location / {
        proxy_pass http://backend-nginx:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
